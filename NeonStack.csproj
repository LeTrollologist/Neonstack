<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NeonStack</RootNamespace>
    <AssemblyName>NeonStack</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>NEON STACK</Product>
    <Company>Audax Softworks</Company>
    <Authors>Audax Softworks</Authors>
    <Description>A neon Tetris clone on the BRUTAL framework.</Description>
    <Copyright>Copyright (c) 2026 Audax Softworks</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned: floating versions make builds non-reproducible (see https://www.nuget.org/profiles/Ahwoo). -->
    <PackageReference Include="Ahwoo.Brutal.Core" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.Brutal.Glfw" Version="2026.10.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/ holds the standalone logo generator and tests/ the headless test harness; neither is
         part of the game assembly. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BRUTAL licence requires NOTICE.txt to ship next to the executable. -->
    <None Update="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Official BRUTAL logo, shown unaltered (scaled) before gameplay as required by licence 2.2. -->
    <EmbeddedResource Include="Assets\logo_brutal_wht.png" LogicalName="NeonStack.Assets.logo_brutal_wht.png" />
    <!-- Generated Audax Softworks logo, shown on the first splash screen. -->
    <EmbeddedResource Include="Assets\logo_audax.png" LogicalName="NeonStack.Assets.logo_audax.png" />
    <!-- Generated NEON STACK title lockup and window icon. -->
    <EmbeddedResource Include="Assets\logo_neonstack.png" LogicalName="NeonStack.Assets.logo_neonstack.png" />
    <EmbeddedResource Include="Assets\icon_neonstack.png" LogicalName="NeonStack.Assets.icon_neonstack.png" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
