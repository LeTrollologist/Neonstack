<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NeonStack</RootNamespace>
    <AssemblyName>NeonStack</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin these to the exact versions you see on https://www.nuget.org/profiles/Ahwoo -->
    <PackageReference Include="Ahwoo.Brutal.Core" Version="*" />
    <PackageReference Include="Ahwoo.Brutal.Glfw" Version="*" />
  </ItemGroup>

</Project>
